// A voice whose clause is a product of experts: style * physicality * rhythm
// (spec, "Clauses and factors"). Play with, e.g.,
//   f1r3score play country_voice.score --notes 32 --stream A=prng:3 --gc freshness --midi out.mid
score CountryVoice
import std
pitches   { r, scale pentatonic C4 .. C6 }
durations { h = 1/2, q = 1/4, e = 1/8 }
timbres   { piano = gm(0) on 1, bass = gm(32) on 2 }

factor stepwise = table step { -2..2: 3, _: 3/10 }
factor country  = machine pitch { C4 -> D4 @ 2, C4 -> E4 @ 3, D4 -> E4 @ 1, D4 -> C4 @ 1,
                                  E4 -> G4 @ 2, E4 -> D4 @ 1, G4 -> A4 @ 1, G4 -> E4 @ 2,
                                  A4 -> G4 @ 2, A4 -> C5 @ 1, C5 -> A4 @ 1, C5 -> D5 @ 1,
                                  D5 -> C5 @ 2, D5 -> E5 @ 1, E5 -> D5 @ 1, E5 -> G5 @ 1,
                                  G5 -> E5 @ 1, G5 -> A5 @ 1, A5 -> G5 @ 1, A5 -> C6 @ 1,
                                  C6 -> A5 @ 1 }
factor rhythm   = machine dur { h -> q @ 1, q -> q @ 3, q -> e @ 2, q -> h @ 1, e -> e @ 3, e -> q @ 2 }
factor walking  = machine pitch { C4 -> E4 @ 1, E4 -> G4 @ 1, G4 -> A4 @ 1, A4 -> G4 @ 1, G4 -> C4 @ 1 }
factor slow     = machine dur { h -> h @ 3, h -> q @ 1, q -> h @ 1 }

play Voice(piano, country * stepwise * rhythm, C5, q, "A") #A
   | Voice(bass,  walking * slow,              C4, h, "B") #B
